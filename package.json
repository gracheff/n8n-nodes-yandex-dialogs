{
  "name": "n8n-nodes-yandex-dialogs",
  "version": "1.0.5",
  "description": "n8n community node for Yandex Dialogs (Alice voice assistant)",
  "keywords": [
    "n8n-community-node-package",
    "yandex",
    "dialogs",
    "alice",
    "voice",
    "webhook"
  ],
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gracheff/n8n-nodes-yandex-dialogs.git"
  },
  "bugs": {
    "url": "https://github.com/gracheff/n8n-nodes-yandex-dialogs/issues"
  },
  "homepage": "https://github.com/gracheff/n8n-nodes-yandex-dialogs#readme",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run tsc && npm run copy:icons",
    "tsc": "tsc",
    "copy:icons": "copyfiles -u 1 \"nodes/**/*.svg\" dist/nodes",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint nodes --ext .ts",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/YandexDialogs/YandexDialogsTrigger.node.js",
      "dist/nodes/YandexDialogs/YandexDialogs.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "n8n-workflow": "^2.9.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  }
}
